# Copy to .env. Keep .env private: it is excluded from Git.
# Base directory for the local database and optional image embeddings.
FRESHHEAD_DATA=data

# Optional. Without these, the daily digest is saved inside the app.
# Do not paste Telegram credentials into issues, commits or screenshots.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default is loopback only. Do not expose the app publicly without authentication.
# FRESHHEAD_ALLOWED_HOSTS=localhost,127.0.0.1
